// Triton 后端示例：向量加法
// 编译命令: hscc . --backend=triton
// 运行命令: python triton_demo.py

import hsc::*;

// 向量加法任务
task vector_add {
    body(a: Buffer<f32>, b: Buffer<f32>, n: i32) -> Buffer<f32> {
        parallel for i in 0..n {
            let sum = a[i] + b[i];
        }
    }
}

// 矩阵乘法任务
task matrix_mul {
    body(a: Buffer<f32>, b: Buffer<f32>, m: i32, n: i32, k: i32) -> Buffer<f32> {
        parallel for i in 0..m {
            for j in 0..n {
                let sum = 0.0;
                for k_idx in 0..k {
                    sum = sum + a[i] * b[k_idx];
                }
            }
        }
    }
}

fn main() {
    // 创建测试数据
    let n: i32 = 1024;
    let a = Buffer::<f32>::zeros([n]);
    let b = Buffer::<f32>::zeros([n]);
    
    // 移动到 GPU
    let a_dev = a.move_to(GPU);
    let b_dev = b.move_to(GPU);
    
    // 启动向加法内核
    let result = spawn on GPU vector_add(a_dev, b_dev, n).await;
    
    // 返回结果
    let result_host = result.move_to(Host);
}